<div class="hero_block-main">
    <h1 class="hero_block-lead">{{ content.title }}</h1>
    <p class="hero_block-explanation">{{ content.description }}</p>
    <div class="hero_block-features">
        <div class="hero_block-container">
            {%- for item in content.features %}
            <div class="hero_block-item">
                <span class="hero_block-check">{{ item.icon }}</span>
                <span>{{ item.text }}</span>
            </div>
            {%- endfor %}
            <a href="{{ content.cta.href }}" class="hero_block-btn">{{ content.cta.text }}</a>
        </div>
    </div>
</div>
